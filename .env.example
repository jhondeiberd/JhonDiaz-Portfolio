# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never commit real values: .gitignore already excludes every .env* file except this one.

# Visit counter and message storage (injected automatically by the Upstash integration in Vercel > Storage)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Contact form email (https://resend.com)
RESEND_API_KEY=
CONTACT_TO=jhondeiberd@gmail.com
CONTACT_FROM=Portfolio <onboarding@resend.dev>

# Optional
VISITS_START=0
IP_HASH_SALT=change-me
